        "mean_f1_plus_20": 0.0894,
        "runs_averaged": 3
      },
      "P1": {
        "initial_accuracy_d0": 13.33,
        "acc_after_5_docs": 13.33,
        "acc_after_10_docs": 16.67,
        "acc_after_20_docs": 20.0,
        "mean_forgetting_delta_20": -6.67,
        "mean_f1_d0": 0.0417,
        "mean_f1_plus_20": 0.0818,
        "runs_averaged": 3
      }
    },
    "mechanistic_insight": "Multi-timescale memory structure enables continual parameter adaptation: Higher level memory (Level 3) stabilizes representations against drift across 20 sequential documents, preventing catastrophic collapse observed in un-regularized fine-tuning."
  },
